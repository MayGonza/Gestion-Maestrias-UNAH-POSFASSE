rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas permisivas para el sistema institucional POSFACE UNAH
    // Permite lectura y escritura de colecciones 'estudiantes', 'usuarios', 'maestrias' y 'configuracion'
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
