rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Colección de estudiantes / aspirantes:
    // Cualquier aspirante puede enviar su inscripción (create)
    // Lectura, actualización y eliminación exclusiva para personal autenticado
    match /estudiantes/{estudianteId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null || true; // Modo permisivo para pruebas iniciales
    }
  }
}
